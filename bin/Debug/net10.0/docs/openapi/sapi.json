{
  "openapi": "3.0.3",
  "info": {
    "title": "SAPI — Access Point Interface (ePošťák SAPI-SK)",
    "version": "v1",
    "description": "Používa rovnaké OAuth kľúče ako zvyšok API. Priamy proxy na upstream SAPI-SK."
  },
  "externalDocs": {
    "description": "ePošťák Enterprise OpenAPI spec",
    "url": "https://epostak.sk/api/openapi.enterprise.json"
  },
  "servers": [
    {
      "url": "/",
      "description": "SAPI-SK Proxy (sapi.patjo.uk)"
    }
  ],
  "paths": {
    "/sapi/v1/auth/token": {
      "post": {
        "tags": [
          "Autentifikácia"
        ],
        "summary": "Získať prístupový token",
        "description": "OAuth2 client_credentials grant. Vráti access_token (15 min) a refresh_token (30 dní).",
        "operationId": "getToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "example": {
                "client_id": "demo_swagger_client",
                "client_secret": "demo_secret_swagger_12345"
              }
            }
          },
          "description": "Request body — príslušná štruktúra."
        },
        "responses": {
          "200": {
            "description": "Token vydaný",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Neplatné credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "IP address not allowed for this client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "423": {
            "description": "Účet dočasne zablokovaný",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sapi/v1/auth/token/status": {
      "get": {
        "tags": [
          "Autentifikácia"
        ],
        "summary": "Skontrolovať platnosť tokenu",
        "operationId": "tokenStatus",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Stav tokenu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenStatus"
                }
              }
            }
          },
          "401": {
            "description": "Neplatný token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          }
        },
        "description": "Operácia: Skontrolovať platnosť tokenu."
      }
    },
    "/sapi/v1/auth/renew": {
      "post": {
        "tags": [
          "Autentifikácia"
        ],
        "summary": "Obnoviť tokeny",
        "description": "Vymení refresh_token za nový pár tokenov. Starý refresh token sa zneplatní.",
        "operationId": "renewToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenewRequest"
              },
              "example": {
                "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_refresh_token"
              }
            }
          },
          "description": "Request body — príslušná štruktúra."
        },
        "responses": {
          "200": {
            "description": "Tokeny obnovené",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Neplatný refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sapi/v1/auth/revoke": {
      "post": {
        "tags": [
          "Autentifikácia"
        ],
        "summary": "Zrušiť refresh token",
        "operationId": "revokeToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeRequest"
              },
              "example": {
                "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_token",
                "token_type_hint": "access_token"
              }
            }
          },
          "description": "Request body — príslušná štruktúra."
        },
        "responses": {
          "200": {
            "description": "Token zrušený",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokeResponse"
                }
              }
            }
          }
        },
        "description": "Operácia: Zrušiť refresh token."
      }
    },
    "/sapi/v1/document/send": {
      "post": {
        "tags": [
          "Dokumenty"
        ],
        "summary": "Odoslať dokument cez Peppol",
        "description": "Odošle UBL XML dokument (faktúra, dobropis, samozdanenie) cez Peppol sieť. Neplatný UBL sa odmietne pred uložením a účtovaním; po oprave použite nový Idempotency-Key, pričom metadata.documentId môžete zachovať. Odpoveď 202 ACCEPTED znamená iba prijatie na spracovanie, nie potvrdené doručenie. providerDocumentId je ePošťák ID dokumentu a pri aktívnom Enterprise prístupe so scope documents:read sa používa ako {id} v GET /api/v1/documents/{id}/status a GET /api/v1/documents/{id}/events. Použite rovnaký Bearer JWT; pri centrálnom sk_int_* pridajte X-Firm-Id odosielajúcej firmy. document.mls_received rozlišuje AP/confirmed, AB/forwarded_unconfirmed a RE/rejected; AB nepotvrdzuje doručenie na C4. document.response_received je samostatná obchodná Invoice Response. Enterprise webhook subscription pre túto firmu pokrýva aj SAPI dokumenty cez document.sent, document.delivered, document.delivery_failed, document.mls_received, document.rejected a document.response_received; jej vytvorenie alebo zmena vyžaduje webhooks:write a udalosti spred aktivácie sa spätne nedopĺňajú.",
        "operationId": "sendDocument",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID pre deduplikáciu (platnosť 24h)",
            "example": "sample-value"
          },
          {
            "name": "X-Peppol-Participant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Peppol ID odosielateľa (napr. 0245:12345678). Pri centrálnom sk_int_* vyberá jednu z pridelených firiem; pre druhého sandbox participanta netreba druhú sadu credentials.",
            "example": "sample-value"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendDocumentRequest"
              },
              "example": {
                "key": "value"
              }
            }
          },
          "description": "Request body — príslušná štruktúra."
        },
        "responses": {
          "202": {
            "description": "Dokument prijatý na spracovanie. Nejde o potvrdenie doručenia Access Pointom príjemcu. Uložte providerDocumentId pre následné sledovanie cez Enterprise status endpoint alebo Enterprise webhook.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendDocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Neplatný request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Authorization error (no organization access)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Konflikt Idempotency-Key (SAPI-PROC-002/003), duplicitný metadata.documentId (SAPI-DOC-018) alebo identický UBL XML payload (SAPI-DOC-024)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Príjemca nie je zaregistrovaný v Peppol sieti (SAPI-DOC-014, details[].issue = participant_not_found), nepodporuje dokument alebo dokument nespĺňa UBL/Peppol pravidlá (SAPI-DOC-015). Od 1. 1. 2027 nesúlad dátumu vystavenia pri odovzdaní používa SAPI-DOC-027 (details[].issue = handoff_date_mismatch), prekročenie lehoty SAPI-DOC-028.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "Chyba Peppol siete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Dočasná nedostupnosť validácie alebo lookupu príjemcu (SAPI-DOC-012). Nezmenený request opakujte s rovnakým Idempotency-Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sapi/v1/document/receive": {
      "get": {
        "tags": [
          "Dokumenty"
        ],
        "summary": "Zoznam prijatých dokumentov",
        "description": "Vráti stránkovaný zoznam dokumentov prijatých cez Peppol.",
        "operationId": "listReceivedDocuments",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-Peppol-Participant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID Peppol účastníka, ktorého dokument sa týka.",
            "example": "sample-value"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Maximálny počet vrátených záznamov.",
            "example": 25
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "RECEIVED",
                "ACKNOWLEDGED"
              ]
            },
            "description": "Filtrum stavu. Povolené hodnoty: RECEIVED, ACKNOWLEDGED.",
            "example": "sample-value"
          },
          {
            "name": "pageToken",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Kurzor pre ďalšiu stránku",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Zoznam dokumentov",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceivedDocumentListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Authorization error (no organization access)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sapi/v1/document/receive/{documentId}": {
      "get": {
        "tags": [
          "Dokumenty"
        ],
        "summary": "Detail prijatého dokumentu",
        "description": "Vráti kompletný dokument vrátane XML payloadu.",
        "operationId": "getReceivedDocument",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID dokumentu (UUID).",
            "example": 123
          },
          {
            "name": "X-Peppol-Participant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID Peppol účastníka, ktorého dokument sa týka.",
            "example": "sample-value"
          }
        ],
        "responses": {
          "200": {
            "description": "Detail dokumentu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceivedDocumentDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Authorization error (document belongs to another receiver)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Dokument neexistuje",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/sapi/v1/document/receive/{documentId}/acknowledge": {
      "post": {
        "tags": [
          "Dokumenty"
        ],
        "summary": "Potvrdiť prijatie dokumentu",
        "description": "Lokálne označí prijatý dokument ako spracovaný (idempotentná operácia). Nie je to transportné potvrdenie pre odosielateľa a nemení jeho outbound delivery status.",
        "operationId": "acknowledgeDocument",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID dokumentu (UUID).",
            "example": 123
          },
          {
            "name": "X-Peppol-Participant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID Peppol účastníka, ktorého dokument sa týka.",
            "example": "sample-value"
          }
        ],
        "responses": {
          "200": {
            "description": "Dokument potvrdený",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcknowledgeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Authorization error (document belongs to another receiver)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Dokument neexistuje",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "TokenRequest": {
        "type": "object",
        "required": [
          "client_id",
          "client_secret",
          "grant_type"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "description": "Client identifier shown with the key. Must match the API key row UUID or displayed key prefix; it is not the sk_live_*/sk_int_* secret.",
            "example": "b6649c59-2f9d-4ae2-a750-af257c455478"
          },
          "client_secret": {
            "type": "string",
            "description": "Full sk_live_* or sk_int_* API key.",
            "example": "sk_live_..."
          },
          "grant_type": {
            "type": "string",
            "enum": [
              "client_credentials"
            ],
            "example": "client_credentials"
          }
        },
        "description": "Požiadavka na vydanie tokenu."
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "example": "<KEY>"
          },
          "refresh_token": {
            "type": "string",
            "example": "<KEY>"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "default": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "default": 900
          },
          "scope": {
            "type": "string",
            "example": "documents:send documents:read"
          }
        },
        "description": "Odpove s tokenom."
      },
      "TokenStatus": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "example": true
          },
          "token_type": {
            "type": "string",
            "enum": [
              "access"
            ],
            "description": "Always 'access' (this endpoint introspects access tokens only). Distinct from POST /auth/token's response.token_type which is the HTTP scheme name 'Bearer'.",
            "example": "access"
          },
          "client_id": {
            "type": "string",
            "example": "demo_swagger_client"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T10:00:00Z"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T10:00:00Z"
          },
          "expires_in_seconds": {
            "type": "integer",
            "example": 1
          },
          "should_refresh": {
            "type": "boolean",
            "description": "True when current time is within 3 minutes of expiry — clients should call /auth/renew",
            "example": true
          },
          "refresh_recommended_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T10:00:00Z"
          }
        },
        "description": "Schema TokenStatus. Popis: TokenStatus."
      },
      "RenewRequest": {
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "example": "<KEY>"
          }
        },
        "description": "Schema RenewRequest. Popis: Renew (request)."
      },
      "RevokeRequest": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "example": "<KEY>"
          },
          "token_type_hint": {
            "type": "string",
            "default": "refresh_token"
          }
        },
        "description": "Schema RevokeRequest. Popis: Revoke (request)."
      },
      "RevokeResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operácia prebehla úspešne."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T10:00:00Z"
          }
        },
        "description": "Schema RevokeResponse. Popis: Revoke (response)."
      },
      "DocumentMetadata": {
        "type": "object",
        "required": [
          "documentId",
          "documentTypeId",
          "processId",
          "senderParticipantId",
          "receiverParticipantId",
          "creationDateTime"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "maxLength": 255,
            "example": "INV-2026-001"
          },
          "documentTypeId": {
            "type": "string",
            "example": "urn:oasis:names:specification:ubl:schema:xsd:Invoice-2::Invoice##urn:cen.eu:en16931:2017#compliant#urn:fdc:peppol.eu:2017:poacc:billing:3.0::2.1"
          },
          "processId": {
            "type": "string",
            "example": "urn:fdc:peppol.eu:2017:poacc:billing:01:1.0"
          },
          "senderParticipantId": {
            "type": "string",
            "example": "0245:12345678"
          },
          "receiverParticipantId": {
            "type": "string",
            "example": "0245:87654321"
          },
          "creationDateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T10:00:00Z"
          }
        },
        "description": "Schema DocumentMetadata. Popis: DocumentMetadata."
      },
      "SendDocumentRequest": {
        "type": "object",
        "required": [
          "metadata",
          "payload",
          "payloadFormat"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/DocumentMetadata"
          },
          "payload": {
            "type": "string",
            "description": "UBL XML obsah dokumentu",
            "maxLength": 10485760,
            "example": "sample"
          },
          "payloadFormat": {
            "type": "string",
            "enum": [
              "XML"
            ],
            "default": "XML"
          },
          "payloadEncoding": {
            "type": "string",
            "enum": [
              "UTF-8"
            ],
            "default": "UTF-8",
            "description": "Optional. Only \"UTF-8\" is supported."
          },
          "checksum": {
            "type": "string",
            "description": "SHA-256 hash payloadu (hex, voliteľné)",
            "example": "sample"
          }
        },
        "description": "Schema SendDocumentRequest. Popis: SendDocument (request)."
      },
      "SendDocumentResponse": {
        "type": "object",
        "required": [
          "providerDocumentId",
          "status",
          "timestamp"
        ],
        "properties": {
          "providerDocumentId": {
            "type": "string",
            "description": "ePošťák ID outbound dokumentu. Pri Enterprise prístupe ho použite ako {id} v GET /api/v1/documents/{id}/status.",
            "example": "31315263"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "REJECTED"
            ],
            "description": "SAPI intake stav. ACCEPTED znamená prijatie na spracovanie, nie potvrdené Peppol doručenie.",
            "example": "ACCEPTED"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T10:00:00Z"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T10:00:00Z"
          }
        },
        "description": "Schema SendDocumentResponse. Popis: SendDocument (response)."
      },
      "ReceivedDocumentListResponse": {
        "type": "object",
        "required": [
          "documents"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentMetadata"
            },
            "example": [
              {}
            ]
          },
          "nextPageToken": {
            "type": "string",
            "nullable": true,
            "example": "<KEY>"
          }
        },
        "description": "Schema ReceivedDocumentListResponse. Popis: ReceivedDocument (list)  (response)."
      },
      "ReceivedDocumentDetailResponse": {
        "type": "object",
        "required": [
          "metadata",
          "payload",
          "payloadFormat"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/DocumentMetadata"
          },
          "payload": {
            "type": "string",
            "description": "Pôvodný UBL XML",
            "example": "sample"
          },
          "payloadFormat": {
            "type": "string",
            "default": "XML"
          }
        },
        "description": "Schema ReceivedDocumentDetailResponse. Popis: ReceivedDocument (detail)  (response)."
      },
      "AcknowledgeResponse": {
        "type": "object",
        "required": [
          "documentId",
          "status",
          "acknowledgedDateTime"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "example": "31315263"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACKNOWLEDGED"
            ],
            "example": "ACKNOWLEDGED"
          },
          "acknowledgedDateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T10:00:00Z"
          }
        },
        "description": "Schema AcknowledgeResponse. Popis: Acknowledge (response)."
      },
      "SAPIError": {
        "type": "object",
        "required": [
          "category",
          "code",
          "message",
          "retryable",
          "correlation_id"
        ],
        "description": "SAPI v1.0 structured error object. All error responses use this consistent structure for machine-readable error handling, explicit retry behaviour, and Peppol-aligned diagnostics.",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "AUTH",
              "VALIDATION",
              "PROCESSING",
              "TEMPORARY",
              "PERMANENT"
            ],
            "description": "Error category. AUTH = authentication/authorization failures. VALIDATION = request validation errors. PROCESSING = server-side processing errors. TEMPORARY = transient failures (retryable). PERMANENT = non-retryable failures.",
            "example": "VALIDATION"
          },
          "code": {
            "type": "string",
            "description": "Stable, implementation-independent error code (e.g. SAPI-AUTH-001, SAPI-VAL-001)",
            "example": "SAPI-AUTH-001"
          },
          "message": {
            "type": "string",
            "description": "Human-readable summary of the error",
            "example": "Operácia prebehla úspešne."
          },
          "details": {
            "type": "array",
            "description": "Optional field-level or contextual information to aid diagnostics",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "The field that caused the error"
                },
                "issue": {
                  "type": "string",
                  "description": "Description of the issue"
                },
                "value": {
                  "type": "string",
                  "description": "The invalid value that was provided"
                }
              }
            },
            "example": []
          },
          "retryable": {
            "type": "boolean",
            "description": "Explicit indicator whether the request may be retried without modification. Clients MUST implement exponential backoff when true.",
            "example": false
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier used for tracing, logging, and support",
            "example": "d3a0d5c2-7f11-4b6a-9a3a-1e0f6d1c2b3a"
          }
        }
      },
      "ErrorResponseEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/SAPIError"
          }
        },
        "description": "Obalk chybovej odpovede."
      }
    }
  }
}