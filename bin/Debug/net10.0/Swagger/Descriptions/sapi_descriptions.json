  "endpoints": {
    "POST /sapi/auth/token": {
      "d": "Vydá prístupový JWT token a refresh token pomocou OAuth 2.0 client_credentials grantu. Token expiruje za 15 minút, refresh token za 30 dní. Priradenie: klient `demo_swagger_client` / `demo_secret_swagger_12345` funguje len proti demo prostrediu.",
      "b": {
        "example": {
          "grant_type": "client_credentials",
          "client_id": "demo_swagger_client",
          "client_secret": "demo_secret_swagger_12345"
        }
      }
    },
    "GET /sapi/auth/token/status": {
      "d": "Skontroluje platnosť aktuálneho access token — expiraciu, scopes, identitu klienta."
    },
    "POST /sapi/auth/renew": {
      "d": "Obnoví prístupový token pomocou refresh_tokenu. Volané, ked token expiroval.",
      "b": {
        "example": {
          "grant_type": "refresh_token",
          "refresh_token": "<KEY>"
        }
      }
    },
    "POST /sapi/auth/revoke": {
      "d": "Zruší refresh token (RFC 7009). Po zrušeni uzavretie prístupu.",
      "b": {
        "example": {
          "token": "<KEY>",
          "token_type_hint": "refresh_token"
        }
      }
    },
    "POST /sapi/document/send": {
      "d": "Odošle elektronicky dokument cez Peppol (faktúra, dobropis, objednávka). Vrati providerDocumentId + initial status. Dokument musi prejst BIS validaciou.",
      "b": {
        "example": {
          "documentType": "invoice",
          "receiver": {
            "scheme": "iso6523-icd",
            "id": "31315263"
          },
          "sender": {
            "scheme": "iso6523-icd",
            "id": "43115885"
          },
          "lines": [
            {
              "name": "Služba 1",
              "quantity": 1,
              "unitPrice": 100
            }
          ]
        }
      }
    },
    "GET /sapi/document/receive": {
      "d": "Zoznam prijatých (inbound) dokumentov s kurzorovym stránkovanim.",
      "p": {
        "cursor": "Kurzor z predchádzajúcej odpovede.",
        "limit": "Max 100 dokumentov na stranku."
      }
    },
    "GET /sapi/document/receive/{documentId}": {
      "d": "Detail jedného prijatého dokumentu vrátane base64 UBL payloadu."
    },
    "POST /sapi/document/receive/{documentId}/acknowledge": {
      "d": "Potvrdí prevzatie dokumentu (idempotente).",
      "b": {
        "example": {}
      }
    },
