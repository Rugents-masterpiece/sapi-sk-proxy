    },
    "POST /api/v1/connector/documents": {
      "d": "Vytvorí (naimportuje) business dokument z JSON.",
      "b": {
        "example": {
          "customerRef": "acme-corp",
          "documentType": "invoice",
          "data": {
            "invoiceNumber": "2026-001",
            "total": 121.0,
            "lines": [
              {
                "name": "Služba",
                "quantity": 1,
                "unitPrice": 100
              }
            ]
          }
        }
      }
